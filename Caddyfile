{
  # Use Let's Encrypt staging for testing, switch to prod for real deployment
  acme_ca https://acme-v02.api.letsencrypt.org/directory
  auto_https off  # Disable HTTPS for local dev
}

# Handle wildcard subdomains
*.localhost {
  header {
    +X-Subdomain {labels.1}
  }
  reverse_proxy host.docker.internal:5173
}

# Handle root domain
localhost {
  reverse_proxy host.docker.internal:5173
}
